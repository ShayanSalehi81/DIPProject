# Copy this file to .env. SAMPLE_COUNT controls the number of paired image-question
# samples; the evaluator sends each one in clean, degraded, and restored form.
SAMPLE_COUNT=100
RANDOM_SEED=20260805

# Phase 1 paths (resolved relative to this RobustnessCheck directory).
DATA_PIPELINE_ROOT=../DataDegradationPipeline
GENERATED_MANIFEST=../DataDegradationPipeline/outputs/manifests/generated.jsonl
RESTORED_MANIFEST=../DataDegradationPipeline/outputs/manifests/restored.jsonl
SAMPLE_MANIFEST=outputs/samples.jsonl
RESULTS_PATH=outputs/evaluation_results.jsonl
ANALYSIS_OUTPUT_DIR=outputs/analysis

# Sampling policy. The default study uses one single-degradation recipe per unique
# Micro-Bench image and balances task, degradation, severity, and modality.
QUESTION_TYPES=domain,modality,classification,subdomain,submodality,stain
SEVERITIES=weak,medium,strong
INCLUDE_MIXED_DEGRADATIONS=false
ALLOW_SYNTHETIC_BENCHMARK_ROWS=false
VERIFY_IMAGES=true

# vLLM / evaluation client.
MODEL_ID=Qwen/Qwen3-VL-8B-Instruct
VLLM_API_BASE=http://localhost:8007/v1
VLLM_API_KEY=EMPTY
REQUEST_TIMEOUT_SECONDS=180
MAX_RETRIES=3
CONCURRENCY=4
MAX_TOKENS=32
TEMPERATURE=0
STRICT_COMPLETENESS=true

# Statistical analysis and figures.
BOOTSTRAP_RESAMPLES=10000
CONFIDENCE_LEVEL=0.95
FIGURE_DPI=300

# Docker deployment. HF_TOKEN is optional for this public model but useful for
# authenticated downloads/rate limits. Never commit a real token.
HF_TOKEN=
HF_CACHE_DIR=/home/YOUR_USER/.cache/huggingface
GPU_DEVICE_ID=0
VLLM_HOST_PORT=8007
VLLM_IMAGE=vllm/vllm-openai:latest
TENSOR_PARALLEL_SIZE=1
MAX_MODEL_LEN=16384
GPU_MEMORY_UTILIZATION=0.90

# Optional proxy settings.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,qwen3-vl

